          "valueLabels": {
            "disabled": {
              "en": "Off",
              "zh-Hans": "关"
            },
            "motion blur": {
              "en": "Motion Blur",
              "zh-Hans": "运动模糊"
            },
            "smart": {
              "en": "Smart",
              "zh-Hans": "智能"
            }
          },
          "values": [
            "disabled",
            "smart",
            "motion blur"
          ]
        }
