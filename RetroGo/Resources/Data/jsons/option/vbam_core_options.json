  "groups": [
    {
      "description": {
        "en": "BIOS, hardware and cartridge settings.",
        "zh-Hans": "BIOS、机型与卡带设置。"
      },
      "id": "system",
      "options": [
        {
          "categoryId": "system",
          "defaultValue": "disabled",
          "description": {
            "en": "Use official BIOS when available. Core needs to be restarted for changes to apply.",
            "zh-Hans": "可用时使用官方 BIOS 文件，开机会显示 GBA 的开机动画，兼容性也更好。需要先在核心 BIOS 中添加对应文件。"
          },
          "key": "vbam_usebios",
          "restartRequired": true,
          "title": {
            "en": "Use Official BIOS",
            "zh-Hans": "使用官方 BIOS"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        },
        {
          "categoryId": "system",
          "defaultValue": "disabled",
          "description": {
            "en": "Forces the internal real-time clock to be enabled regardless of rom. Usuable for rom patches that requires clock to be enabled (aka Pokemon).",
            "zh-Hans": "不论 ROM 是否声明都启用卡带内的实时时钟。部分改版游戏（例如宝可梦系列的改版）需要开启才能正常计时。"
          },
          "key": "vbam_forceRTCenable",
          "restartRequired": true,
          "title": {
            "en": "Force-Enable RTC",
            "zh-Hans": "强制启用实时时钟"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        },
        {
          "categoryId": "system",
          "defaultValue": "gbc",
          "description": {
            "en": "Sets the Game Boy hardware type to emulate. Restart core to apply.",
            "zh-Hans": "模拟哪种 GB 机型。「自动」按游戏选择。"
          },
          "key": "vbam_gbHardware",
          "restartRequired": true,
          "title": {
            "en": "(GB) Emulated Hardware",
            "zh-Hans": "模拟机型（GB）"
          },
          "type": "select",
          "valueLabels": {
            "auto": {
              "en": "Automatic",
              "zh-Hans": "自动"
            },
            "gb": {
              "en": "Game Boy",
              "zh-Hans": "Game Boy"
            },
            "gba": {
              "en": "Game Boy Advance",
              "zh-Hans": "Game Boy Advance"
            },
            "gbc": {
              "en": "Game Boy Color",
              "zh-Hans": "Game Boy Color"
            },
            "sgb": {
              "en": "Super Game Boy",
              "zh-Hans": "Super Game Boy"
            },
            "sgb2": {
              "en": "Super Game Boy 2",
              "zh-Hans": "Super Game Boy 2"
            }
          },
          "values": [
            "gbc",
            "auto",
            "sgb",
            "gb",
            "gba",
            "sgb2"
          ]
        },
        {
          "categoryId": "system",
          "defaultValue": "disabled",
          "description": {
            "en": "Allows Colorizer hacked GB games (e.g. DX patched games) to normally run in GBC/GBA hardware type. This also disables the use of bios file. NOT RECOMMENDED for use on non-colorized games.",
            "zh-Hans": "让经过上色改版的 GB 游戏（例如 DX 补丁版）能在 GBC/GBA 机型下正常运行。开启后不再使用 BIOS 文件。非改版游戏不建议开启。"
          },
          "key": "vbam_allowcolorizerhack",
          "restartRequired": true,
          "title": {
            "en": "(GB) Enable Colorizer Hack",
            "zh-Hans": "允许上色改版（GB）"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        }
      ],
      "title": {
        "en": "System",
        "zh-Hans": "系统"
      }
