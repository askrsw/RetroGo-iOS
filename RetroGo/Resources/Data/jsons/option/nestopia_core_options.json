    {
      "description": {
        "en": "Change system region and other hardware-related settings.",
        "zh-Hans": "主机制式与 FDS 磁盘设置。"
      },
      "id": "system",
      "options": [
        {
          "categoryId": "system",
          "defaultValue": "auto",
          "description": {
            "en": "Choose the emulated console region. 'Auto' detects it from the ROM and falls back to NTSC.",
            "zh-Hans": "选择模拟的主机制式。「自动」会根据 ROM 信息识别，无法识别时使用 NTSC。"
          },
          "key": "nestopia_favored_system",
          "restartRequired": true,
          "title": {
            "en": "System Region",
            "zh-Hans": "主机制式"
          },
          "type": "select",
          "valueLabels": {
            "auto": {
              "en": "Auto",
              "zh-Hans": "自动"
            },
            "dendy": {
              "en": "Dendy",
              "zh-Hans": "Dendy"
            },
            "famicom": {
              "en": "Famicom",
              "zh-Hans": "Famicom"
            },
            "ntsc": {
              "en": "NTSC",
              "zh-Hans": "NTSC"
            },
            "pal": {
              "en": "PAL",
              "zh-Hans": "PAL"
            }
          },
          "values": [
            "auto",
            "ntsc",
            "pal",
            "famicom",
            "dendy"
          ]
        },
        {
          "categoryId": "system",
          "defaultValue": "enabled",
          "description": {
            "en": "Automatically insert first FDS disk on reset.",
