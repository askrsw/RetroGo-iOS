{
  "coreId": "mame",
  "format": "libretro-core-options-v2",
  "groups": [
    {
      "description": {
        "en": "Internal MAME processing settings.",
        "zh-Hans": "MAME 内部运行设置。"
      },
      "id": "system",
      "options": [
        {
          "categoryId": "system",
          "defaultValue": "enabled",
          "description": {
            "en": "Allow MAME to use worker threads for internal tasks. This is separate from RetroGo's independent game logic thread. Keep enabled unless troubleshooting performance or stability.",
            "zh-Hans": "允许 MAME 使用工作线程处理内部任务。此设置与 RetroGo 的「游戏逻辑独立线程」不同，通常保持开启；排查性能或稳定性问题时可尝试关闭。"
          },
          "key": "mame_thread_mode",
          "restartRequired": true,
          "title": {
            "en": "MAME Internal Multithreading",
            "zh-Hans": "MAME 内部多线程"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        }
      ],
      "title": {
        "en": "System",
        "zh-Hans": "系统"
      }
    },
    {
      "description": {
        "en": "Screen orientation and software rendering resolution.",
        "zh-Hans": "画面方向与软件渲染分辨率。"
      },
      "id": "video",
      "options": [
        {
          "categoryId": "video",
          "defaultValue": "libretro",
          "description": {
            "en": "Choose how to orient games designed for a rotated display, such as 1941. Automatic lets RetroGo apply the rotation reported by the core; MAME rotates inside the core. Left and right modes rotate the display for a physically rotated screen, not the controls.",
            "zh-Hans": "选择竖向显示游戏（如《1941》）的画面旋转方式。「自动」由 RetroGo 按核心提供的方向旋转；「MAME 内部旋转」由核心处理。向左或向右旋转用于配合转动设备观看，不会调整方向键映射。"
          },
          "key": "mame_rotation_mode",
          "restartRequired": true,
          "title": {
            "en": "Screen Rotation",
            "zh-Hans": "画面旋转方式"
          },
          "type": "select",
          "valueLabels": {
            "internal": {
              "en": "MAME Rotation",
              "zh-Hans": "MAME 内部旋转"
            },
            "libretro": {
              "en": "Automatic",
              "zh-Hans": "自动"
            },
            "none": {
              "en": "No Rotation",
              "zh-Hans": "不旋转"
            },
            "tate-rol": {
              "en": "Rotate Left",
              "zh-Hans": "向左旋转"
            },
            "tate-ror": {
              "en": "Rotate Right",
              "zh-Hans": "向右旋转"
            }
          },
          "values": [
            "libretro",
            "internal",
            "tate-rol",
            "tate-ror",
            "none"
          ]
        },
        {
          "categoryId": "video",
          "defaultValue": "disabled",
          "description": {
            "en": "Render to a fixed resolution instead of the size chosen by the game. This scales the original graphics and does not add detail to arcade sprites. Higher resolutions increase processing cost; leaving this off preserves the game's native rendering size.",
            "zh-Hans": "使用固定分辨率代替游戏自动确定的渲染尺寸。这会缩放原有画面，不会增加街机精灵图像的细节。更高分辨率会增加运算开销；通常关闭即可保留游戏的原生渲染尺寸。"
          },
          "key": "mame_alternate_renderer",
          "restartRequired": true,
          "title": {
            "en": "Custom Render Resolution",
            "zh-Hans": "自定义渲染分辨率"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        },
        {
          "categoryId": "video",
          "defaultValue": "640x480",
          "description": {
            "en": "Output size used when Custom Render Resolution is enabled. Match the game's aspect ratio to avoid stretching. Larger sizes cost more processing time and memory.",
            "zh-Hans": "开启「自定义渲染分辨率」时使用的输出尺寸。请匹配游戏的画面比例，避免拉伸；更大的尺寸会增加运算和内存开销。"
          },
