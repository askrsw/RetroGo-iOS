{
  "coreId": "mednafen-saturn",
  "format": "libretro-core-options-v2",
  "groups": [
    {
      "description": {
        "en": "Region, BIOS language, clock and disc loading settings.",
        "zh-Hans": "地区、BIOS 语言、时钟与光盘读取设置。"
      },
      "id": "general",
      "options": [
        {
          "categoryId": "general",
          "defaultValue": "Auto Detect",
          "description": {
            "en": "The console region. Auto Detect follows the game. Japanese consoles use the sega_101.bin BIOS and the other regions use mpr-17933.bin, so the matching BIOS must be added to the core.",
            "zh-Hans": "主机的地区。「自动检测」会跟随游戏。日本地区的主机使用 sega_101.bin BIOS，其他地区使用 mpr-17933.bin，需要在核心 BIOS 中添加对应的文件。"
          },
          "key": "beetle_saturn_region",
          "restartRequired": true,
          "title": {
            "en": "System Region",
            "zh-Hans": "主机地区"
          },
          "type": "select",
          "valueLabels": {
            "Asia (NTSC)": {
              "en": "Asia (NTSC)",
              "zh-Hans": "亚洲（NTSC）"
            },
            "Asia (PAL)": {
              "en": "Asia (PAL)",
              "zh-Hans": "亚洲（PAL）"
            },
            "Auto Detect": {
              "en": "Auto Detect",
              "zh-Hans": "自动检测"
            },
            "Brazil": {
              "en": "Brazil",
              "zh-Hans": "巴西"
            },
            "Europe": {
              "en": "Europe",
              "zh-Hans": "欧洲"
            },
            "Japan": {
              "en": "Japan",
              "zh-Hans": "日本"
            },
            "Latin America": {
              "en": "Latin America",
              "zh-Hans": "拉丁美洲"
            },
            "North America": {
              "en": "North America",
              "zh-Hans": "北美"
            },
            "South Korea": {
              "en": "South Korea",
              "zh-Hans": "韩国"
            }
          },
          "values": [
            "Auto Detect",
            "Japan",
            "North America",
            "Europe",
            "South Korea",
            "Asia (NTSC)",
            "Asia (PAL)",
            "Brazil",
            "Latin America"
          ]
        },
        {
          "categoryId": "general",
          "defaultValue": "english",
          "description": {
            "en": "The language of the Saturn BIOS menu. Some games that include several languages also follow it. The BIOS has no Chinese.",
            "zh-Hans": "土星 BIOS 菜单使用的语言，部分内含多种语言的游戏也会跟随它。BIOS 不支持中文。"
          },
          "key": "beetle_saturn_autortc_lang",
          "restartRequired": true,
          "title": {
            "en": "BIOS Language",
            "zh-Hans": "BIOS 语言"
          },
          "type": "select",
          "valueLabels": {
            "english": {
              "en": "English",
              "zh-Hans": "英语"
            },
            "japanese": {
              "en": "Japanese",
              "zh-Hans": "日语"
            }
          },
          "values": [
            "english",
            "japanese"
          ]
        },
        {
          "categoryId": "general",
          "defaultValue": "disabled",
          "description": {
            "en": "Loads the whole disc image into memory when the game starts. Starting takes longer and uses more memory, but loading inside the game can be faster.",
            "zh-Hans": "启动游戏时把整个光盘镜像读入内存。启动会变慢、占用更多内存，但游戏中的读盘可能更快。"
          },
          "key": "beetle_saturn_cdimagecache",
          "restartRequired": true,
          "title": {
            "en": "CD Image Cache",
            "zh-Hans": "光盘镜像缓存"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        },
        {
          "categoryId": "general",
          "defaultValue": "disabled",
          "description": {
            "en": "Reads input in the middle of the frame as well, which can lower input latency in some games at the cost of more CPU time.",
            "zh-Hans": "在一帧的中途也读取输入，可降低部分游戏的输入延迟，但会占用更多 CPU。"
          },
          "key": "beetle_saturn_midsync",
          "restartRequired": false,
          "title": {
            "en": "Mid-frame Input Synchronization",
            "zh-Hans": "帧中输入同步"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "disabled",
            "enabled"
          ]
        },
        {
          "categoryId": "general",
          "defaultValue": "enabled",
          "description": {
            "en": "Sets the console clock to the device's current date and time when a game starts.",
            "zh-Hans": "启动游戏时把主机时钟设为设备当前的日期和时间。"
          },
          "key": "beetle_saturn_autortc",
          "restartRequired": true,
          "title": {
            "en": "Set Clock Automatically",
            "zh-Hans": "自动设置时钟"
          },
          "type": "bool",
          "valueLabels": {
            "disabled": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "enabled": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "enabled",
            "disabled"
          ]
        }
      ],
      "title": {
        "en": "General",
        "zh-Hans": "通用"
      }
    },
