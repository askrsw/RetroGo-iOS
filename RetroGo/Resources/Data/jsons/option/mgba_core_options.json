          "type": "select",
          "valueLabels": {
            "OFF": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "ON": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "ON",
            "OFF"
          ]
        },
        {
          "categoryId": "system",
          "defaultValue": "OFF",
          "description": {
            "en": "When using an official BIOS/bootloader, skip the start-up logo animation. This setting is ignored when 'Use BIOS File if Found' is disabled.",
            "zh-Hans": "使用官方 BIOS 时跳过开机标志动画。仅在启用「使用官方 BIOS」且已添加对应文件时有效。"
          },
          "key": "mgba_skip_bios",
          "restartRequired": true,
          "title": {
            "en": "Skip BIOS Intro",
            "zh-Hans": "跳过 BIOS 开机动画"
          },
          "type": "select",
          "valueLabels": {
            "OFF": {
              "en": "OFF",
              "zh-Hans": "关"
            },
            "ON": {
              "en": "ON",
              "zh-Hans": "开"
            }
          },
          "values": [
            "OFF",
            "ON"
          ],
          "visibleWhen": [
            {
              "mgba_use_bios": [
                "ON"
              ]
            }
          ]
