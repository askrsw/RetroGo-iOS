    {
      "description": {
        "en": "Configure controller / sensor input and controller rumble settings.",
        "zh-Hans": "方向输入、模拟光照与手柄震动设置。"
      },
      "id": "input",
      "options": [
        {
          "categoryId": "input",
          "defaultValue": "no",
          "description": {
            "en": "Enabling this will allow pressing / quickly alternating / holding both left and right (or up and down) directions at the same time. This may cause movement-based glitches.",
            "zh-Hans": "允许同时按住左右或上下方向。可能引发移动异常，通常建议关闭。"
          },
          "key": "mgba_allow_opposing_directions",
          "restartRequired": false,
          "title": {
            "en": "Allow Opposing Directions",
            "zh-Hans": "允许相反方向同时输入"
          },
          "type": "select",
          "valueLabels": {
            "no": {
              "en": "Off",
              "zh-Hans": "关"
            },
            "yes": {
              "en": "On",
              "zh-Hans": "开"
            }
          },
          "values": [
            "no",
            "yes"
          ]
        },
        {
          "categoryId": "input",
          "defaultValue": "0",
          "description": {
            "en": "Set simulated sunlight intensity for games with a cartridge solar sensor, such as the Boktai series. Higher values mean stronger sunlight. L3/R3 can also adjust the level.",
            "zh-Hans": "调整《太阳少年》系列等光感卡带游戏中模拟的阳光强度。数值越大，光照越强，也可通过 L3/R3 调整。"
          },
          "key": "mgba_solar_sensor_level",
          "restartRequired": false,
          "title": {
            "en": "Solar Sensor Level",
            "zh-Hans": "光感强度"
          },
          "type": "select",
          "valueLabels": {
            "0": {
              "en": "0",
              "zh-Hans": "0"
