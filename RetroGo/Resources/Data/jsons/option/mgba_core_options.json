        {
          "categoryId": "system",
          "defaultValue": "Autodetect",
          "description": {
            "en": "Runs loaded content with a specific Game Boy model. 'Autodetect' will select the most appropriate model for the current game.",
            "zh-Hans": "指定运行 GB/GBC 游戏时模拟的机型。「自动检测」会为当前游戏选择合适的机型。"
          },
          "key": "mgba_gb_model",
          "restartRequired": true,
          "title": {
            "en": "Game Boy Model",
            "zh-Hans": "模拟机型（GB）"
