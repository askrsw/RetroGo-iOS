        {
          "categoryId": "system",
          "defaultValue": "ON",
          "description": {
            "en": "Use the official BIOS/bootloader when available. Add the corresponding file in the core's BIOS settings first.",
            "zh-Hans": "可用时使用对应机型的官方 BIOS 或引导程序。需要先在核心 BIOS 中添加对应文件。"
          },
          "key": "mgba_use_bios",
          "restartRequired": true,
          "title": {
            "en": "Use Official BIOS",
            "zh-Hans": "使用官方 BIOS"
