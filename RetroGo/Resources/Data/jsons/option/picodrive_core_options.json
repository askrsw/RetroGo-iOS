    {
      "description": {
        "en": "Aspect ratio, filter and renderer settings.",
        "zh-Hans": "画面比例、滤镜与渲染方式。"
      },
      "id": "video",
      "options": [
        {
          "categoryId": "video",
          "defaultValue": "PAR",
          "description": {
            "en": "The display aspect ratio. 'PAR' keeps the original pixel ratio and 'CRT' mimics a period television.",
            "zh-Hans": "画面的显示比例。PAR 为原始像素比例，CRT 模拟当年电视的观感。"
