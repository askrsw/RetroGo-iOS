    {
      "description": {
        "en": "Frameskip settings.",
        "zh-Hans": "跳帧设置。"
      },
      "id": "performance",
      "options": [
        {
          "categoryId": "performance",
          "defaultValue": "disabled",
          "description": {
            "en": "Skip frames to avoid audio buffer under-run (crackling). Improves performance at the expense of visual smoothness. 'Auto' skips frames when advised by the frontend. 'Manual' utilises the 'Frameskip Threshold (%)' setting.",
            "zh-Hans": "跳过部分画面以避免音频缓冲不足导致的爆音，代价是画面不够流畅。「自动」按前端提示跳帧，「手动」使用下面的阈值。"
          },
          "key": "picodrive_frameskip",
          "restartRequired": false,
          "title": {
            "en": "Frameskip",
            "zh-Hans": "跳帧"
          },
          "type": "select",
          "valueLabels": {
            "auto": {
              "en": "Auto",
              "zh-Hans": "自动"
            },
            "disabled": {
              "en": "Off",
              "zh-Hans": "关"
            },
            "manual": {
              "en": "Manual",
              "zh-Hans": "手动"
            }
          },
          "values": [
            "disabled",
            "auto",
            "manual"
          ]
        },
        {
          "categoryId": "performance",
          "defaultValue": "33",
          "description": {
            "en": "When 'Frameskip' is set to 'Manual', specifies the audio buffer occupancy threshold (percentage) below which frames will be skipped. Higher values reduce the risk of crackling by causing frames to be dropped more frequently.",
            "zh-Hans": "跳帧设为「手动」时，音频缓冲低于该百分比就开始跳帧。数值越高跳帧越频繁，越不容易爆音。"
          },
          "key": "picodrive_frameskip_threshold",
          "restartRequired": false,
          "title": {
            "en": "Frameskip Threshold",
            "zh-Hans": "跳帧阈值"
          },
          "type": "select",
          "valueLabels": {
