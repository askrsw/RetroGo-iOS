        {
          "categoryId": "video",
          "defaultValue": "off",
          "description": {
            "en": "Apply an image 'ghosting' filter to mimic the display characteristics of the Game Gear and 'Genesis Nomad' LCD panels.",
            "zh-Hans": "模拟 Game Gear 和 Genesis Nomad 掌机 LCD 屏幕的残影效果。"
          },
          "key": "picodrive_ggghost",
          "restartRequired": false,
          "title": {
            "en": "LCD Ghosting Filter",
            "zh-Hans": "LCD 残影滤镜"
