          "restartRequired": false,
          "title": {
            "en": "Renderer",
            "zh-Hans": "渲染方式"
          },
          "type": "select",
          "valueLabels": {
            "accurate": {
              "en": "Accurate",
              "zh-Hans": "精确"
            },
            "fast": {
              "en": "Fast",
              "zh-Hans": "快速"
            },
            "good": {
              "en": "Good",
              "zh-Hans": "良好"
            }
          },
          "values": [
            "accurate",
            "good",
            "fast"
          ]
        }
      ],
      "title": {
        "en": "Video",
        "zh-Hans": "视频"
