      "options": [
        {
          "categoryId": "audio",
          "defaultValue": "44100",
          "description": {
            "en": "Higher values increase sound quality. Lower values may increase performance. Native is the Mega Drive sound chip rate (~53000). Select this if you want the most accurate audio.",
            "zh-Hans": "采样率越高音质越好，越低性能越好。「原生」是 MD 声音芯片本身的频率（约 53000 Hz），最还原真机。"
          },
          "key": "picodrive_sound_rate",
          "restartRequired": true,
          "title": {
            "en": "Sample Rate",
            "zh-Hans": "音频采样率"
