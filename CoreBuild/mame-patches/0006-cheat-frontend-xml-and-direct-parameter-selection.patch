+//-------------------------------------------------
+//  select_parameter_position - RetroGo: switch a
+//  parameter cheat on at the given position
+//-------------------------------------------------
+
+bool cheat_entry::select_parameter_position(unsigned position)
+{
+	if (m_parameter == nullptr)
+		return false;
+
+	bool changed(false);
+	if (m_state == SCRIPT_STATE_OFF)
+	{
+		changed = set_state(SCRIPT_STATE_RUN);
+		m_parameter->set_minimum_state();
+	}
+	changed = m_parameter->set_position(position) || changed;
+
+	// same as select_next_state: one-shot parameters only apply on activate()
+	if (changed && !is_oneshot_parameter())
+		execute_change_script();
+
+	return changed;
+}
