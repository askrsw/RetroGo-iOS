+//-------------------------------------------------
+//  position - RetroGo: 0-based position of the
+//  current value (item index or steps from min)
+//-------------------------------------------------
+
+int cheat_parameter::position() const
+{
+	if (has_itemlist())
+	{
+		for (size_t index = 0; index < m_itemlist.size(); index++)
+			if (m_itemlist[index].value() == m_value)
+				return int(index);
+		return -1;
+	}
+	uint64_t const step = m_stepval ? uint64_t(m_stepval) : 1;
+	return int((uint64_t(m_value) - uint64_t(m_minval)) / step);
+}
+
+
+//-------------------------------------------------
+//  set_position - RetroGo: jump straight to a
+//  position without walking the states between
+//-------------------------------------------------
+
+bool cheat_parameter::set_position(unsigned position)
+{
+	uint64_t const origvalue(m_value);
+
+	if (has_itemlist())
+	{
+		if (position >= m_itemlist.size())
+			return false;
+		m_value = m_itemlist[position].value();
+	}
+	else
+	{
+		uint64_t const step = m_stepval ? uint64_t(m_stepval) : 1;
+		uint64_t const value = uint64_t(m_minval) + step * position;
+		m_value = (value > uint64_t(m_maxval) || value < uint64_t(m_minval)) ? uint64_t(m_maxval) : value;
+	}
+
+	return m_value != origvalue;
+}
+
