+bool cheat_manager::load_frontend_xml()
+{
+	std::string xml;
+	{
+		std::lock_guard<std::mutex> lock(s_frontend_xml_mutex);
+		xml = s_frontend_xml;
+	}
+	if (xml.empty())
+		return false;
+
+	// open_ram does not copy: `xml` outlives the file
+	util::core_file::ptr file;
+	if (util::core_file::open_ram(xml.data(), xml.size(), OPEN_FLAG_READ, file))
+	{
+		osd_printf_error("Cheats: could not open the frontend cheat data\n");
+		return true;
+	}
+	try
+	{
+		parse_cheat_file(*file, machine().basename(), "frontend");
+		osd_printf_verbose("Loaded %d cheats handed over by the frontend\n", int(m_cheatlist.size()));
